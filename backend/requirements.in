# Top-level dependencies: exact versions released at least two weeks before adoption.
# requirements.txt is the hashed lock generated from this file; never edit it by hand. After a change
# here or in requirements-dev.in, regenerate both locks from backend/ with a cutoff at least 14 days
# back (and after the newest pin here was uploaded):
#   uv pip compile requirements.in --universal --python-version 3.13 --generate-hashes --exclude-newer <cutoff> -o requirements.txt
#   uv pip compile requirements-dev.in -c requirements.txt --universal --python-version 3.13 --generate-hashes --exclude-newer <cutoff> -o requirements-dev.txt
