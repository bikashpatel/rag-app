#!/bin/sh
# Sourced by the nginx image's entrypoint before it renders /etc/nginx/templates (nginx.conf): the
# upload route accepts MAX_UPLOAD_MB_HARD plus 10 MB of multipart overhead.
case "${MAX_UPLOAD_MB_HARD:-100}" in
    '' | *[!0-9]*) echo "MAX_UPLOAD_MB_HARD must be a whole number of MB" >&2; exit 1 ;;
esac
export NGINX_UPLOAD_BODY_MB=$(( ${MAX_UPLOAD_MB_HARD:-100} + 10 ))
