# Copy to .env and fill in. Never commit .env.
# Docker Compose expands $ in this file: wrap any value that contains $ in single quotes, e.g.
# ADMIN_PASSWORD='my$ecret-pass' (double quotes don't help), or write $$ for each literal $.

# --- Admin login (the only admin; synced on every backend start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# --- Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# --- Model provider keys (read by LiteLLM; add any other provider key LiteLLM supports) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Postgres (use URL-safe characters or rely on the app's escaping) ---
# Applied only when the database volume is first created. To change them later, change them inside
# Postgres as well, or reset all data with `docker compose down -v`.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=rag

# --- Web port on this machine (http://localhost:8080) ---
APP_PORT=8080

# --- Defaults pre-filled when the admin creates a user (0 = unlimited) ---
DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
DEFAULT_RATE_LIMIT_PER_MIN=20
DEFAULT_MAX_UPLOAD_MB=25
DEFAULT_MAX_DOCUMENTS=100
DEFAULT_MAX_STORAGE_MB=500
# Absolute per-file cap. nginx accepts this + 10 MB on the upload route for multipart overhead;
# apply a change with `docker compose up -d`.
MAX_UPLOAD_MB_HARD=100

# --- Retrieval tuning ---
RAG_TOP_K=6
CHUNK_SIZE=1800
CHUNK_OVERLAP=250
HISTORY_MESSAGES=10
WORKER_CONCURRENCY=2

# --- Advanced (optional; defaults shown, uncomment to change) ---
# Failed logins allowed within the window, per username and per client IP, then 429.
# Raise LOGIN_MAX_ATTEMPTS_PER_IP if many users share one public IP.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_MAX_ATTEMPTS_PER_IP=100
# LOGIN_WINDOW_SECONDS=900
# Timeout for each model call. Keep it below 600: nginx closes a stream that sends nothing for 600 s.
# LLM_TIMEOUT_SECONDS=300
# max_tokens for chat models whose "Max output tokens" is blank in the admin page, lowered to the
# model's own output limit when LiteLLM's model map lists one.
# DEFAULT_MAX_OUTPUT_TOKENS=16000
# Ingestion: texts per embedding request, zip-bomb guards for docx/pptx/xlsx (whole file, and each XML
# part of a docx/pptx), extracted-text cap per document, PDF page cap, and the time one parse may take.
# EMBED_BATCH_SIZE=64
# MAX_UNCOMPRESSED_MB=100
# MAX_XML_PART_MB=32
# MAX_EXTRACTED_CHARS=5000000
# MAX_PDF_PAGES=5000
# PARSE_TIMEOUT_SECONDS=300
# Vision model for PDFs (Admin -> Models -> Vision models). Page images are sent to the model's provider.
# A page with fewer than VISION_MIN_TEXT_CHARS characters of text whose images cover at least
# VISION_MIN_IMAGE_RATIO of it is transcribed; a page with text and images that large gets a description of
# them. At most VISION_MAX_PAGES (up to 200) pages per document (scanned pages first; more scans fail the PDF),
# VISION_CONCURRENCY calls at a time per document and VISION_MAX_IN_FLIGHT in the worker, and no new call
# after VISION_TIMEOUT_SECONDS. Each user may use VISION_MONTHLY_TOKEN_LIMIT vision tokens a month (0 =
# unlimited; the admin is exempt). Pages are rendered with a long edge of VISION_MAX_IMAGE_PX pixels (at most
# 2576); VISION_MAX_OUTPUT_TOKENS caps each page's output when the model's "Max output tokens" is blank.
# VISION_MAX_PAGES=50
# VISION_CONCURRENCY=3
# VISION_MAX_IN_FLIGHT=4
# VISION_TIMEOUT_SECONDS=1800
# VISION_MONTHLY_TOKEN_LIMIT=2000000
# VISION_MIN_TEXT_CHARS=40
# VISION_MIN_IMAGE_RATIO=0.1
# VISION_MAX_IMAGE_PX=1568
# VISION_MAX_OUTPUT_TOKENS=8192
# Files from chat: when the user asks, the assistant creates PDF, Word, Excel or Markdown files and saves them to
# their private documents (only models that support function calling). One answer may create
# GENERATED_FILES_PER_ANSWER files (at most 10), each with at most GENERATED_FILE_MAX_CHARS characters of content.
# Calls that may write a file request GENERATED_FILE_MAX_OUTPUT_TOKENS output tokens (a model's own Max output
# tokens wins). Each file gets GENERATED_FILE_TIMEOUT_SECONDS to render, waiting for a slot included;
# GENERATED_FILE_CONCURRENCY files render at once per backend process. Files count toward the user's document,
# storage and per-file limits (the admin is exempt). Offering the tool adds about 1,550 input tokens to every call
# of a capable chat model, file or not; CHAT_FILE_TOOLS=false turns the feature off.
# CHAT_FILE_TOOLS=true
# GENERATED_FILES_PER_ANSWER=3
# GENERATED_FILE_MAX_CHARS=100000
# GENERATED_FILE_MAX_OUTPUT_TOKENS=48000
# GENERATED_FILE_TIMEOUT_SECONDS=60
# GENERATED_FILE_CONCURRENCY=2
# Images from chat: when the user asks, the assistant generates images with the active image model (Admin ->
# Models -> Image models; OpenAI or Azure OpenAI GPT image models), shows them in the answer and saves them to the
# user's private documents. Image prompts go to that provider. One answer may generate GENERATED_IMAGES_PER_ANSWER
# images (at most 10); new users may generate DEFAULT_MONTHLY_IMAGE_LIMIT images per month unless the admin sets their
# own number (0 = unlimited; existing users got this value once and keep their own). IMAGE_MAX_QUALITY caps the cost
# per image (low, medium or high; GPT Image 2 measured about $0.006 for a square low image, $0.042 for a landscape
# medium one). IMAGE_OUTPUT_FORMAT is png (measured about 0.7 MB for a square low image, 2.7 MB for a landscape medium
# one), jpeg or webp (both much smaller). Each image may take IMAGE_TIMEOUT_SECONDS, waiting for a slot included;
# IMAGE_CONCURRENCY images are generated at once per backend process. Offering the tool adds about 1,040 input tokens
# to every call of a capable chat model, image or not; CHAT_IMAGE_TOOLS=false turns the feature off and keeps
# existing images.
# CHAT_IMAGE_TOOLS=true
# GENERATED_IMAGES_PER_ANSWER=3
# DEFAULT_MONTHLY_IMAGE_LIMIT=30
# IMAGE_MAX_QUALITY=medium
# IMAGE_OUTPUT_FORMAT=png
# IMAGE_TIMEOUT_SECONDS=180
# IMAGE_CONCURRENCY=3
# Memory limit of the worker container (Docker Compose only).
# WORKER_MEM_LIMIT=4g
# Replaces the POSTGRES_* connection settings, e.g. for an external database.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/db
# Only for an external Qdrant that requires an API key.
# QDRANT_API_KEY=
# Changing the prefix after documents are indexed points retrieval at new, empty collections until
# every document is re-indexed.
# QDRANT_COLLECTION_PREFIX=rag_chunks
# Changing the cookie name signs everyone out.
# COOKIE_NAME=rag_session
# APP_NAME=RAG App

# --- Plugins (Admin -> Plugins). Gmail setup, step by step: docs/gmail-setup.md ---
# Origins the app is opened at, comma-separated (scheme://host[:port], no path). Google sign-in redirects only to
# <origin>/api/plugins/gmail/oauth/callback for these, so register that URI for each one in Google Cloud. A Cloudflare
# tunnel URL changes on every restart: add it here AND in Google (redirect URI, and the tunnel's host under Branding ->
# Authorized domains if the console asks), or connect once at http://localhost:8080 (the connection then works from
# any address, because tokens are kept on the server).
PUBLIC_BASE_URLS=http://localhost:8080
# Encrypts users' OAuth tokens in the database. Generate one with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Rotate: put a new key first (comma-separated) and run docker compose up -d; every start re-encrypts connections
# under the first key. Remove the old key only when Admin -> Plugins no longer warns about connections on an older
# key. Losing every key means every user must reconnect. Independent of SECRET_KEY on purpose, so rotating SECRET_KEY
# keeps Gmail connections working.
TOKEN_ENCRYPTION_KEY=
# Gmail: a "Web application" OAuth client from Google Cloud with the redirect URI
# http://localhost:8080/api/plugins/gmail/oauth/callback (docs/gmail-setup.md). Either empty: Gmail is "not configured".
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# true while the Google app's publishing status is "Testing": only its test users can connect, and Google ends each
# connection after 7 days (the app then shows "Reconnect needed"). Set false once the app is Internal or In production.
# GOOGLE_OAUTH_TESTING_MODE=true
# Gmail limits: tool calls and characters of email per chat answer, emails sent per user per UTC day (the admin
# too), minutes a proposed email stays sendable, total attachment size per email (at most 18), items per import.
# GMAIL_TOOL_CALLS_PER_ANSWER=5
# GMAIL_MAX_CHARS_PER_ANSWER=40000
# GMAIL_DAILY_SEND_LIMIT=20
# GMAIL_SEND_CONFIRM_MINUTES=30
# GMAIL_MAX_ATTACHMENT_MB=15
# GMAIL_IMPORT_MAX_ITEMS=20
# Test setups only (a fake Google server); leave unset.
# GOOGLE_OAUTH_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_OAUTH_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GMAIL_API_BASE_URL=https://gmail.googleapis.com

# --- Account (Settings -> Plugins & data -> Export my data) ---
# Uncompressed content of one data export (1 to 1000); the oldest conversations beyond it are left out.
# EXPORT_MAX_MB=100
# Seconds to build one export (10 to 90): nothing is sent before, and the Cloudflare tunnel cuts silence at ~100 s.
# EXPORT_TIMEOUT_SECONDS=80

# --- Backups (the backup service; scripts/README.md) ---
# What a backup holds: Postgres (pg_dump), the uploaded files and Qdrant's collections (snapshots, so a restore needs no
# re-embedding). NOT this file: keep a copy of .env (above all SECRET_KEY and TOKEN_ENCRYPTION_KEY) in a password
# manager. Without the same TOKEN_ENCRYPTION_KEY every user must reconnect Gmail after a restore.
# Where backups go on this machine. They hold personal data: keep the folder outside the repo's Docker build contexts
# (./backend, ./frontend) and out of git (./backups is git-ignored). Copy it off this machine too (scripts/README.md).
# BACKUP_DIR=./backups
# Daily backup times in UTC, HH:MM, comma-separated for several (02:30 UTC is 08:00 in India). One also runs
# BACKUP_START_DELAY_SECONDS after the service starts while no backup exists.
# BACKUP_SCHEDULE=02:30
# BACKUP_START_DELAY_SECONDS=120
# Retention: the newest backup of each of the last BACKUP_KEEP_DAILY days and BACKUP_KEEP_WEEKLY weeks that have one.
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# Linux only: give the backup files to this user and group (e.g. `id -u`, `id -g`), so an off-site copy (rclone)
# can read them without root. Unset: root owns them (Docker Desktop shows them as yours anyway).
# BACKUP_UID=
# BACKUP_GID=
# Shown in Admin -> System and written to backup manifests. Usually set by the deploy, e.g.
# APP_VERSION=$(git describe --always --dirty) docker compose up -d
# APP_VERSION=

# --- Monitoring and alerts (the monitor service; Admin -> System) ---
# Alerts are sent when something breaks, as a reminder every ALERT_REPEAT_HOURS while it stays broken (0: never), and
# when it recovers. A change must show up in ALERT_CONFIRM_CHECKS checks in a row, MONITOR_INTERVAL_SECONDS apart.
# Without any channel below, alerts are only logged (docker compose logs monitor) and shown in Admin -> System.
# Alerts never include secrets, document names, email contents or usernames. After a change: docker compose up -d
# MONITOR_INTERVAL_SECONDS=60
# ALERT_CONFIRM_CHECKS=2
# ALERT_REPEAT_HOURS=6
# The name alerts start with, e.g. "[RAG Assistant] Problem: Backups".
# ALERT_NAME=RAG Assistant
# Alert when the last good backup is older than this (0: no backup checks), when pending documents waited longer than
# ALERT_QUEUE_STUCK_MINUTES while none finished, and when a disk has less than ALERT_DISK_MIN_FREE_PERCENT free
# (critical below half of it).
# BACKUP_MAX_AGE_HOURS=26
# ALERT_QUEUE_STUCK_MINUTES=30
# ALERT_DISK_MIN_FREE_PERCENT=10
# The app through nginx, checked from inside Docker (empty: not checked).
# MONITOR_APP_URL=http://frontend/api/health
# A worker heartbeat older than WORKER_HEARTBEAT_MAX_AGE_SECONDS makes the app "not ready" (GET /api/health/ready).
# WORKER_HEARTBEAT_SECONDS=15
# WORKER_HEARTBEAT_MAX_AGE_SECONDS=60
# Channels: any, all or none. Test them with Admin -> System -> Send a test alert.
# A webhook that takes JSON {"text": "..."}: a Slack or Google Chat incoming webhook, a Discord webhook with /slack at
# the end, or a Microsoft Teams incoming webhook. The URL is a secret.
# ALERT_WEBHOOK_URL=
# Push to your phone with ntfy (https://ntfy.sh, or your own server): the topic URL, e.g. https://ntfy.sh/<long random
# topic name>, and an access token if the topic is protected.
# ALERT_NTFY_URL=
# ALERT_NTFY_TOKEN=
# Email over SMTP: port 587 with STARTTLS, or ALERT_SMTP_SECURITY=ssl for port 465 (none: a local relay without TLS).
# ALERT_SMTP_TO is comma-separated.
# For Gmail, use an app password (Google Account -> Security -> App passwords).
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_SECURITY=starttls
# ALERT_SMTP_USERNAME=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_FROM=
# ALERT_SMTP_TO=

# --- Only when the backend runs outside Docker Compose ---
# docker-compose.yml sets these for the backend and worker, which overrides any value here.
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# UPLOAD_DIR=/data/uploads
