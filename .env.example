# Copy to .env and fill in. Never commit .env.

# --- Admin login (the only admin; synced on every backend start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# --- Model provider keys (read by LiteLLM; add any other provider key LiteLLM supports) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Postgres (use URL-safe characters or rely on the app's escaping) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=rag

# --- Web port on this machine (http://localhost:8080) ---
APP_PORT=8080

# --- Defaults pre-filled when the admin creates a user (0 = unlimited) ---
DEFAULT_MONTHLY_TOKEN_LIMIT=1000000
DEFAULT_RATE_LIMIT_PER_MIN=20
DEFAULT_MAX_UPLOAD_MB=25
DEFAULT_MAX_DOCUMENTS=100
DEFAULT_MAX_STORAGE_MB=500
# Absolute per-file cap (nginx allows a little more for multipart overhead)
MAX_UPLOAD_MB_HARD=100

# --- Retrieval tuning ---
RAG_TOP_K=6
CHUNK_SIZE=1800
CHUNK_OVERLAP=250
HISTORY_MESSAGES=10
WORKER_CONCURRENCY=2
